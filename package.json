{
  "name": "kabaad-to-karodpati",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "tauri:dev": "npm run tauri:dev --workspace=apps/desktop",
    "cap:sync": "npm run cap:sync --workspace=apps/mobile",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}