{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "build/**", "*.exe", "*.apk", "*.aab"]
    },
    "lint": {},
    "typecheck": {
      "outputs": []
    }
  },
  "globalEnv": ["NODE_ENV"]
}